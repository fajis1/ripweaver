# Copy this file to .env and fill in only the values you use.
# Never commit .env. Rotate keys that were previously stored in source files.

# External metadata services
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Disc tools
MAKEMKV_PATH=C:\Program Files (x86)\MakeMKV\makemkvcon64.exe
MAKEMKV_KEY=
HANDBRAKE_PATH=C:\Program Files\HandBrake\HandBrakeCLI.exe
FFPROBE_PATH=
FFMPEG_PATH=

# Optional catalog-constrained unmatched-episode fallback
GEMINI_PRIMARY_API_KEY=
GEMINI_PAID_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
